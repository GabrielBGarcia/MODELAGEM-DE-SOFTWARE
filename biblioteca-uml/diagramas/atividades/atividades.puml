@startuml atividades
title Diagrama de Atividades – Empréstimo, Renovação e Devolução

|#E6F2FF|Usuário|
|#EAF7EA|Sistema|
|#FFF4DC|Bibliotecário|
|#FBE6E6|Sistema de Multas|

|Usuário|
start
:Consultar livro no acervo;

|Sistema|
:Buscar livro e exibir resultado;

if (Existe exemplar disponível?) then (sim)
  |Usuário|
  :Solicitar empréstimo;

  |Sistema|
  if (Usuário apto?\n(sem multa pendente e dentro do limite)) then (sim)
    fork
      :Registrar empréstimo;
    fork again
      :Marcar exemplar como indisponível;
    fork again
      :Calcular prazo de devolução;
    end fork
    :Confirmar empréstimo ao usuário;
  else (não)
    :Negar empréstimo;
    |Usuário|
    :Receber aviso de empréstimo negado;
    stop
  endif
else (não)
  |Usuário|
  :Solicitar reserva do livro;
  |Sistema|
  :Registrar reserva;
  :Avisar usuário quando houver exemplar;
  stop
endif

|Usuário|
if (Deseja renovar o empréstimo?) then (sim)
  |Sistema|
  if (Existe reserva de outro usuário?) then (sim)
    :Negar renovação;
  else (não)
    :Estender prazo de devolução;
  endif
else (não)
endif

|Usuário|
:Devolver a obra;

|Bibliotecário|
:Receber obra e verificar atraso;

if (Houve atraso?) then (sim)
  |Sistema de Multas|
  :Calcular valor da multa;
  |Bibliotecário|
  :Aplicar multa ao usuário;
  |Sistema|
  :Registrar multa;
else (não)
endif

|Sistema|
:Registrar devolução;
:Marcar exemplar como disponível;
stop

@enduml
